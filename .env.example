# 诚勤指标中枢 OpenAPI 凭证与参数（复制为真实配置时切勿提交本文件的真实值）
# baseUrl 有默认值，仅当平台地址变更时才需要设置
# CNU_METRICS_BASE_URL=https://metrics.ynu.edu.cn
CNU_METRICS_APP_KEY=your_app_key
CNU_METRICS_APP_SECRET=your_app_secret
CNU_METRICS_USERNAME=your_username

# 可选：请求超时（毫秒）
# CNU_METRICS_TIMEOUT_MS=45000
# 可选：分页单页上限
# CNU_METRICS_PAGE_SIZE_LIMIT=200
# 可选：默认场景版本 uid（不传 scene 参数时使用）
# CNU_METRICS_DEFAULT_SCENE_UID=
